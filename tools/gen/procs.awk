# The proc table: every function GL/gl.h and GL/gl3_funcs.h declare, by name,
# for sic_gl_proc() (SDL_GL_GetProcAddress and friends). Run by the Makefile:
#   awk -f tools/gen/procs.awk include/GL/gl.h include/GL/gl3_funcs.h > lib/gl/procs.inc
BEGIN { print "/* generated by tools/gen/procs.awk from GL/gl.h and GL/gl3_funcs.h: do not edit */" }
/GLAPIENTRY gl[A-Za-z0-9_]+\(/ {
    s = $0
    sub(/.*GLAPIENTRY /, "", s)
    sub(/\(.*/, "", s)
    if (!(s in seen)) { seen[s] = 1; printf "    { \"%s\", (void *)%s },\n", s, s }
}
