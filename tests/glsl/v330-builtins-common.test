[fragment]
#version 330
out vec4 o;
void main() {
  float m = mod(-1.5, 1.0);                 // 0.5
  vec2 c = clamp(vec2(-1.0, 2.0), 0.0, 1.0);
  float s = smoothstep(0.0, 1.0, 0.5);      // 0.5
  float st = step(0.5, 0.75);               // 1
  vec3 mx = mix(vec3(0.0), vec3(1.0), 0.25);
  bvec2 sel = bvec2(true, false);
  vec2 mb = mix(vec2(1.0, 2.0), vec2(3.0, 4.0), sel);  // (3, 2)
  float ip; float fr = modf(2.75, ip);
  int ia = abs(-3); int isg = sign(-7);
  o = vec4(m + c.y - 1.0 + s, st * mx.x * 4.0, (mb.x + mb.y) / 5.0, (fr + ip + float(ia + isg)) / 4.75);
}
[expect]
all 1 1 1 1
