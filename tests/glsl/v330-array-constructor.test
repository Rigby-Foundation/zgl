[fragment]
#version 330
out vec4 o;
const float k[3] = float[3](0.5, 0.25, 0.125);
void main() {
  vec2 v[] = vec2[](vec2(1.0, 0.0), vec2(0.0, 1.0));
  float s = 0.0;
  for (int i = 0; i < k.length(); i++) s += k[i];
  o = vec4(s, v[1].y, v[0].x * 0.5, float(v.length()) * 0.5);
}
[expect]
all 0.875 1 0.5 1
