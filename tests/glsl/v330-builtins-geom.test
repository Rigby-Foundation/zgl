[fragment]
#version 330
out vec4 o;
void main() {
  vec3 x = cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0));     // (0,0,1)
  float l = length(vec3(3.0, 4.0, 0.0));                       // 5
  vec3 n = normalize(vec3(0.0, 3.0, 4.0));                     // (0, .6, .8)
  vec3 r = reflect(vec3(1.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0)); // (1, 1, 0)
  float d = distance(vec2(1.0, 1.0), vec2(4.0, 5.0));          // 5
  o = vec4(x.z, l / 5.0 + n.y - 0.6, n.z / 0.8 * r.y, d / 5.0);
}
[expect]
all 1 1 1 1
