[vertex]
#version 330
layout(location = 0) in vec2 zgl_pos;
out vec2 uv;
void main() { uv = zgl_pos * 0.5 + 0.5; gl_Position = vec4(zgl_pos, 0.0, 1.0); }
[fragment]
#version 330
in vec2 uv;
layout(location = 0) out vec4 color;
void main() { color = vec4(uv.y, uv.x, 1.0, 1.0); }
[expect]
pixel 2 6 0.8125 0.3125 1 1
