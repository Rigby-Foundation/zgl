[fragment]
#version 330
out vec4 o;
void main() {
  int s = 0;
  for (int i = 0; i < 10; i++) { if (i == 2) continue; if (i == 6) break; s += i; }   // 0+1+3+4+5 = 13
  int w = 0; int n = 0;
  while (true) { n++; if (n % 2 == 0) continue; w += n; if (n > 6) break; }           // 1+3+5+7 = 16
  int d = 0; int k = 0;
  do { k++; if (k == 3) continue; d += k; } while (k < 5);                            // 1+2+4+5 = 12
  int nest = 0;
  for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) { if (j > i) break; nest++; } // 6
  o = vec4(float(s) / 13.0, float(w) / 16.0, float(d) / 12.0, float(nest) / 6.0);
}
[expect]
all 1 1 1 1
