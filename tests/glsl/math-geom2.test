[fragment]
#version 330
out vec4 o;
void main() {
  vec3 f = faceforward(vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0));   // -N
  vec3 r = refract(vec3(0.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0), 1.0);                       // straight through
  vec3 tir = refract(normalize(vec3(1.0, -0.1, 0.0)), vec3(0.0, 1.0, 0.0), 1.5);           // total internal reflection: 0
  o = vec4(-f.z, -r.y, 1.0 - length(tir), 1.0);
}
[expect]
all 1 1 1 1
