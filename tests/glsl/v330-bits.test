[fragment]
#version 330
out vec4 o;
void main() {
  uint u = floatBitsToUint(1.0);            // 0x3f800000
  float back = uintBitsToFloat(u + 0x00800000u);  // 2.0
  bool n = isnan(0.0 / 0.0 + uintBitsToFloat(0x7fc00000u));
  bool i = isinf(uintBitsToFloat(0x7f800000u));
  o = vec4(u == 0x3f800000u ? 1.0 : 0.0, back / 2.0, n ? 1.0 : 0.0, i ? 1.0 : 0.0);
}
[expect]
all 1 1 1 1
